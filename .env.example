# Vorlage für lokale Umgebungsvariablen. Kopieren nach .env und Werte setzen.
# Secrets nie einchecken; .env steht in .gitignore.
# Die Variablen werden ab Phase 2a vom Backend gelesen.

# PostgreSQL (docker-compose ab Phase 2a)
DATABASE_URL=postgres://timelog:timelog@localhost:5432/timelog

# Backend
PORT=3000
LOG_LEVEL=info

# JWT-Signaturschlüssel (lange Zufallswerte, z. B. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# HMAC-Schlüssel für Netzwerk-Kennungen (zusätzlich zum Salt je Organisation)
NETWORK_HMAC_SECRET=

# E-Mail-Versand für Bestätigung und Passwort-Reset
SMTP_URL=
MAIL_FROM=

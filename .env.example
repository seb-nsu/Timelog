# Vorlage für lokale Umgebungsvariablen. Kopieren nach .env und Werte setzen.
# Secrets nie einchecken; .env steht in .gitignore.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16 (docker compose up -d)
DATABASE_URL=postgres://timelog:timelog@localhost:5432/timelog

# Signaturschlüssel für Access-Tokens, mindestens 32 Zeichen (z. B. `openssl rand -base64 48`)
JWT_SECRET=

# Schlüssel für die Verschlüsselung der TOTP-Geheimnisse: 32 Byte als Base64 (`openssl rand -base64 32`)
TOTP_ENCRYPTION_KEY=

# Geheimnis für die HMAC-Schlüssel der Arbeitsnetz-Kennungen (BSSID, Netzwerk-Fingerprint), mind. 32 Zeichen
# Nicht ändern, sobald Netze gespeichert sind: alte Kennungen passen sonst nicht mehr.
NETWORK_HMAC_SECRET=

# Basis-URL für Links in Mails (Bestätigung, Passwort-Reset)
APP_URL=http://localhost:5173

# Firmenversion: Web-Admin (Einladungslinks, SSO-Rücksprung) und öffentliche Adresse der API
# (SSO-Callback, SAML-Metadaten). ADMIN_URL leer = APP_URL.
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:3000
# Ursprünge, die die API direkt per CORS aufrufen dürfen (kommagetrennt). Leer = kein CORS,
# z. B. wenn der Web-Admin über denselben Reverse-Proxy ausgeliefert wird.
CORS_ORIGINS=
# Weitere erlaubte Rücksprung-Ursprünge nach SSO (kommagetrennt), zusätzlich zu ADMIN_URL und APP_URL
SSO_REDIRECT_ORIGINS=

# SSO-Secrets je Organisation: Der Admin trägt im Web-Admin nur den NAMEN der Variable ein
# (Präfix SSO_ Pflicht), der Wert steht ausschließlich hier. Beispiele:
# SSO_ACME_ENTRA_SECRET=
# SSO_ACME_GOOGLE_SECRET=

# E-Mail-Versand; leer = Mails nur in der Konsole (nur Entwicklung, in Produktion Pflicht)
SMTP_URL=
MAIL_FROM=TimeLog <no-reply@localhost>

# Hinter einem Reverse-Proxy auf true setzen (für korrekte Client-IP beim Rate-Limit)
TRUST_PROXY=false

# Integrationstests: vorhandene PostgreSQL statt Testcontainers verwenden (optional)
# TEST_DATABASE_URL=postgres://timelog:timelog@localhost:5432/postgres

# Nur Betrieb mit deploy/compose.prod.yml (docs/BETRIEB.md): Datenbank-Passwort (nur Buchstaben
# und Ziffern, es landet in DATABASE_URL) und Domain, für die Caddy das TLS-Zertifikat holt.
# POSTGRES_PASSWORD=
# API_DOMAIN=api.example.de

# Handy-App (apps/mobile, wirken beim Prebuild/Build)
# Bundle-ID/Paketname; App Group wird daraus als group.<ID> gebildet
# TIMELOG_BUNDLE_ID=de.timelog.mobile
# Vorbelegte Server-Adresse im Einrichtungsassistenten
# TIMELOG_DEFAULT_SERVER=https://zeit.example.org
# 1 = optionaler WLAN-Name auf Android (fügt Standortberechtigungen hinzu, Play-Erklärung nötig)
# TIMELOG_ANDROID_WIFI_NAME=0
# Pfad zur google-services.json für FCM (nicht einchecken)
# TIMELOG_GOOGLE_SERVICES_FILE=./google-services.json
# APNs-Umgebung: development oder production
# TIMELOG_APNS_MODE=development
# EAS_PROJECT_ID=

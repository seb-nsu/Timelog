{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeLog",
  "version": "0.1.0",
  "identifier": "de.timelog.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimeLog",
        "width": 440,
        "height": 680,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Automatische Arbeitszeiterfassung",
    "category": "Productivity",
    "windows": {
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
